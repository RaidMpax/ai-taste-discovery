# Required when importing Last.fm tags.
LASTFM_API_KEY=

# Required only when generating Why This? explanations with Gemini.
GEMINI_API_KEY=

# Optional hosting setting: absolute path to a persistent SQLite file.
# Configure this as a host environment variable, not as a Gemini/Last.fm secret.
# AI_TASTE_DATABASE_PATH=

# Optional override for the pinned public catalogue download. Change both
# values together when publishing a new snapshot; the default is in app.py.
# AI_TASTE_DATABASE_URL=
# AI_TASTE_DATABASE_SHA256=

# Local default keeps behavior events in SQLite. Set to "session" in Streamlit
# Community Cloud Secrets for the free demo so interactions are temporary.
AI_TASTE_BEHAVIOR_STORAGE=persistent
